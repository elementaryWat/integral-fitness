{
  "configVersion": "v3",
  "app": {
    "appId": 1136058,
    "appName": "Recomp",
    "appType": "app",
    "version": { "code": 1, "name": "0.1.0" },
    "icon": "icon.png",
    "vender": "recomp",
    "description": "Registro de series, descanso con vibración y pulso para Recomp"
  },
  "permissions": [
    "data:os.device.info",
    "data:user.hd.heart_rate",
    "device:os.accelerometer",
    "device:os.local_storage"
